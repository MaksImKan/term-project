# ─────────────────────────────────────────────────────────────────────────────
# Контракт змінних середовища Marketplace API.
# Цей файл — ЄДИНИЙ, що лежить у git. Реальний .env ігнорується (.gitignore).
# Джерело правди — src/config/env.schema.ts; звірка: npm run check:env.
# Секретних значень тут немає й бути не може: пароль БД живе у файлі-секреті.
# ─────────────────────────────────────────────────────────────────────────────

# Режим роботи застосунку: development | test | production. Типово development.
NODE_ENV=development

# HTTP-порт застосунку (1..65535). Типово 3000.
PORT=3000

# Рівень логування: debug | info | warn | error. Типово info.
LOG_LEVEL=info

# ОБОВʼЯЗКОВА. DSN Postgres БЕЗ пароля: postgres://<user>@<host>:<port>/<db>.
# Пароль свідомо не входить у DSN — його читає застосунок із DB_PASSWORD_FILE.
#
# Порт 6432 — це PgBouncer (сервіс pgbouncer у docker-compose.yml), а не Postgres.
# Застосунок ходить у базу тільки через пулер; напряму в 5432 ходять лише
# pg_dump / pg_restore / ротація пароля, яким потрібна сесія, а не транзакція.
DB_URL=postgres://marketplace@127.0.0.1:6432/marketplace

# Шлях до файла-секрета з паролем БД (відносно кореня проєкту або абсолютний).
# Файл у .gitignore та у .dockerignore: ані в git, ані в шарах образу його немає.
DB_PASSWORD_FILE=./secrets/db_password

# Максимум зʼєднань у пулі pg (1..100). Типово 10.
DB_POOL_MAX=10

# Таймаут отримання зʼєднання з пулу, мс (100..60000). Типово 5000.
DB_CONNECTION_TIMEOUT_MS=5000

# Чи вмикати TLS до Postgres: true | false. Локально false, у проді true.
DB_SSL=false

# Адреса RabbitMQ (ДЗ-19). Порт 5672 — це AMQP; 15672 — вебморда менеджменту,
# протоколом AMQP вона не відповідає.
# Значення нижче — дев-креденшели стенда з docker-compose.yml, не секрет.
# Реальне значення приходить зі сховища ДЗ-11 тією самою обгорткою, що й DB_URL.
BROKER_URL=amqp://app:app@127.0.0.1:5672

# ── Redis (ДЗ-23) ────────────────────────────────────────────────────────────
# Два інстанси навмисно: кешу потрібні maxmemory + allkeys-lru, черзі BullMQ —
# noeviction. Це несумісні налаштування ОДНОГО процесу (maxmemory-policy одна
# на весь інстанс, SELECT 1 її не розводить).
# Значення нижче — дев-креденшели стенда з docker-compose.yml, не секрет.

# Кеш: maxmemory + allkeys-lru.
REDIS_URL=redis://127.0.0.1:6390

# Черга BullMQ і сесії: noeviction + AOF everysec.
REDIS_QUEUE_URL=redis://127.0.0.1:6391

# Базовий TTL кеша, секунди (1..86400, типово 300).
CACHE_TTL_S=300

# Розкид джитера TTL, секунди (10..3600, типово 60). Нуль заборонений схемою:
# без джитера ключі, прогріті одним циклом, протухають в одну секунду.
CACHE_TTL_JITTER_S=60

# Скільки запитів дозволено на вікно ліміту (1..10000, типово 5).
RATE_LIMIT_MAX=5

# Довжина вікна ліміту в секундах (1..3600, типово 1).
RATE_LIMIT_WINDOW_S=1

# Скільки повідомлень брокер віддає споживачу наперед (1..2000, типово 10).
# Дефолт самого брокера — 0, тобто «без ліміту»: перший споживач забирає всю
# чергу, другий простоює. Обґрунтування числа — у README.
BROKER_PREFETCH=10

# Валідувати ВІДПОВІДІ проти openapi.yaml: true | false. У проді зазвичай false.
VALIDATE_RESPONSES=true

# Валюта за замовчуванням (ISO 4217, рівно 3 символи). Типово UAH.
DEFAULT_CURRENCY=UAH

# Розмір сторінки за замовчуванням для cursor-пагінації (1..100). Типово 20.
DEFAULT_PAGE_LIMIT=20
