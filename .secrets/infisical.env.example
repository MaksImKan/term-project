# Креденшели ДОСТУПУ ДО СХОВИЩА (не креденшели бази!).
# Скопіюй у .secrets/infisical.env і встав свої значення.
# .secrets/ у .gitignore — цей приклад єдиний файл звідти, що лежить у git.

# Проєкт Infisical, у якому живуть DB_* для оточень dev / staging / prod
INFISICAL_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Варіант А: машинна ідентичність (universal auth) — рекомендований
INFISICAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
INFISICAL_CLIENT_SECRET=fake-client-secret-change-me

# Варіант Б: готовий service token замість пари вище
# INFISICAL_TOKEN=st.fake.token.change-me

# Шлях усередині проєкту, якщо секрети не в корені
# INFISICAL_PATH=/
