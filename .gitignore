node_modules/
dist/
spec.json
*.log
*.tsbuildinfo
.DS_Store

# ── Секрети ──────────────────────────────────────────────────────────────────
# Реальні значення змінних. У git лежить лише .env.example.
.env
.env.*
!.env.example

# Файл-секрет із паролем БД. Створюється командою `npm run secrets:init`,
# яка копіює secrets/db_password.example — єдиний файл секретів у git.
secrets/*
!secrets/.gitkeep
!secrets/db_password.example

# Креденшели доступу до сховища (Infisical). У git лежить лише приклад.
.secrets/*
!.secrets/infisical.env.example
