node_modules/
dist/
spec.json
*.log
*.tsbuildinfo
.DS_Store

# ── Секрети ──────────────────────────────────────────────────────────────────
# Реальні значення змінних. У git лежить лише .env.example.
.env
.env.*
!.env.example

# Файл-секрет із паролем БД. Створюється командою `npm run secrets:init`,
# яка копіює secrets/db_password.example — єдиний файл секретів у git.
secrets/*
!secrets/.gitkeep
!secrets/db_password.example

# Креденшели доступу до сховища (Infisical). У git лежить лише приклад.
.secrets/*
!.secrets/infisical.env.example

# Дампи бекапів — артефакти, не код. У git лежить лише скрипт, що їх робить.
backups/

# Pact-контракти (ДЗ-16) — ЗГЕНЕРОВАНИЙ артефакт consumer-тесту, не джерело
# правди. Джерело правди — test/contract/*.consumer.spec.ts і брокер; файл
# щоразу відтворюється командою `npm run test:contract`. Тримати його в git
# означало б розвʼязувати конфлікти в машинному JSON і рано чи пізно
# верифікувати застарілу копію. Порядок на свіжому клоні:
# `npm run test:contract` -> `npm run verify:provider` (див. README).
pacts/
